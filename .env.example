# AWS 認証（SSO ログイン済みのプロファイル名）
AWS_PROFILE=your-profile-name
# Payments 対応リージョン: us-east-1 / us-west-2 / eu-central-1 / ap-southeast-2
AWS_REGION=us-east-1

# Coinbase Developer Platform: https://portal.cdp.coinbase.com/
COINBASE_API_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COINBASE_API_KEY_SECRET=

# Coinbase Server Wallets で生成した EC P-256 base64 秘密鍵
# CDP コンソール → Server Wallets → Create Wallet → Wallet Secret を取得
COINBASE_WALLET_SECRET=
